<?xml version="1.0" encoding="utf-8"?>
<!-- Libro a medias: portada pequenia, titulo y por donde vas. La barra es dorada
     porque el dorado marca estado, que es la regla de toda la aplicacion. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margen_contenido"
    android:paddingVertical="10dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="42dp"
        android:layout_height="63dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="3dp">

        <ImageView
            android:id="@+id/portadaLeyendo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/desc_portada"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloLeyendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/chamberi_text_semibold"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Cien años de soledad" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraLeyendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:indicatorColor="@color/md_tertiary"
            app:trackCornerRadius="4dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/progresoLeyendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="41 % · pág. 182" />
    </LinearLayout>
</LinearLayout>
