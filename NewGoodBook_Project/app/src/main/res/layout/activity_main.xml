<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de arranque. El logotipo ocupaba la pantalla entera estirado de borde a
  borde; ahora va centrado y a tamano fijo sobre el mismo fondo marino que el resto
  de bloques de marca, de modo que el arranque y la bienvenida se ven iguales.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hero_fondo">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="@dimen/tam_logo"
        android:layout_height="@dimen/tam_logo"
        android:layout_gravity="center"
        android:contentDescription="@string/desc_logo"
        app:srcCompat="@drawable/logo_ngb" />

</FrameLayout>
