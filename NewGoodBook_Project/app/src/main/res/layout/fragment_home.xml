<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla principal.

  Principal es para DESCUBRIR, no para leerse la ficha entera: antes casi la mitad de
  la pantalla era un bloque de sinopsis que ademas se cortaba a media frase, y esta
  pantalla acababa siendo igual que la ficha del libro. Ahora la portada manda, la
  sinopsis se queda en cuatro lineas y quien quiera mas entra en la ficha.

  El fondo de detras de la portada lo pinta ColorDeLibro con el tono del libro; el
  color de aqui es solo el que se ve mientras no hay ninguno cargado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".Fragments.HomeIU.HomeFragment">

    <!-- ===== La portada, protagonista, sobre su propio color ===== -->
    <LinearLayout
        android:id="@+id/bloquePortada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hero_fondo"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margen_contenido"
        android:paddingTop="@dimen/hero_espacio_arriba"
        android:paddingBottom="22dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/portada_ancho"
            android:layout_height="@dimen/portada_alto"
            app:cardCornerRadius="8dp"
            app:cardElevation="14dp">

            <ImageView
                android:id="@+id/imageVPortada"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_portada"
                android:scaleType="centerCrop"
                android:transitionName="portada" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:fontFamily="@font/tipografia_semibold"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:textColor="@color/hero_texto"
            android:textSize="@dimen/hero_titulo"
            tools:text="El héroe discreto" />

        <TextView
            android:id="@+id/textAutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/md_tertiary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Mario Vargas Llosa" />

        <!-- Los datos sueltos van como pildoras: antes eran filas de
             "etiqueta: valor" que competian en peso con el titulo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textNumPag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_meta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hero_meta"
                android:textSize="12sp"
                tools:text="349 págs." />

            <TextView
                android:id="@+id/textFechaPub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/fondo_meta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hero_meta"
                android:textSize="12sp"
                tools:text="2013" />

            <TextView
                android:id="@+id/textGeneros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/fondo_meta"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hero_meta"
                android:textSize="12sp"
                tools:text="Novela" />

            <TextView
                android:id="@+id/textValoracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/fondo_meta"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hero_meta"
                android:textSize="12sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_estrella"
                tools:text="4,2"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Acciones ===== -->
    <LinearLayout
        android:id="@+id/filaAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margen_contenido">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tBtnFavorite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorSurface"
            android:text="@string/accion_favorito"
            android:textSize="12sp"
            app:icon="@drawable/ic_favorite_off"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tBtnCheck"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorSurface"
            android:text="@string/accion_leido"
            android:textSize="12sp"
            app:icon="@drawable/ic_checkbox_off"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tBtnAddList"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorSurface"
            android:text="@string/accion_a_lista"
            android:textSize="12sp"
            app:icon="@drawable/ic_addlist"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- ===== Sinopsis, recortada ===== -->
    <TextView
        android:id="@+id/etiquetaSinopsis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="0.12"
        android:paddingHorizontal="@dimen/margen_contenido"
        android:text="@string/etiqueta_sinopsis"
        android:textAllCaps="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Cuatro lineas y punto. El texto entero esta en la ficha, a un toque. -->
    <TextView
        android:id="@+id/textDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/tipografia_regular"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="@integer/sinopsis_lineas"
        android:paddingHorizontal="@dimen/margen_contenido"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        tools:text="Una novela del Premio Nobel de Literatura y Príncipe de Asturias de las Letras Mario Vargas Llosa, en la que dos hombres puestos a prueba por la vida descubren el verdadero sentido del coraje y la lealtad." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSeguirLeyendo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_boton_texto"
        android:text="@string/seguir_leyendo"
        android:textSize="13sp" />

    <!-- empuja las dos acciones de descubrimiento al fondo, donde llega el pulgar -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNoInteresa"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/accion_no_interesa"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSiguiente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_contenido"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/tipografia_semibold"
        android:paddingVertical="12dp"
        android:text="@string/siguiente"
        android:textSize="15sp"
        app:cornerRadius="24dp" />

</LinearLayout>
