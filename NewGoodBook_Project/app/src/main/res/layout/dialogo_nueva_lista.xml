<?xml version="1.0" encoding="utf-8"?>
<!-- Antes era un EditText suelto metido en el dialogo: sin margenes, pegado a los
     bordes, y los errores salian como aviso flotante lejos del campo. -->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/capaNombreLista"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="8dp"
    android:hint="@string/hint_nombre_lista"
    app:counterEnabled="true"
    app:counterMaxLength="40">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/campoNombreLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLength="40" />
</com.google.android.material.textfield.TextInputLayout>
