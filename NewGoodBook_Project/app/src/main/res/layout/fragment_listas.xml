<?xml version="1.0" encoding="utf-8"?>
<!--
  Listas, segun la propuesta aprobada: dos secciones con encabezado en lugar de dos barras
  de herramientas (una de ellas dorada a todo el ancho haciendo de separador), recuento de
  libros en cada fila, y un estado vacio con salida clara cuando aun no hay listas propias.
  El boton de crear pasa de ser un icono escondido en la barra a un boton con texto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".Fragments.Listas">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/myToolbarMisListas"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hero_fondo"
        app:title="@string/title_listas"
        app:titleTextColor="@color/hero_texto" />

    <!-- Lo que estas leyendo va primero: es lo unico de la aplicacion que cambia cada
         dia, y enterrarlo bajo las dos listas fijas era desaprovecharlo. La seccion
         entera desaparece si no hay nada a medias. -->
    <TextView
        android:id="@+id/etiquetaLeyendo"
        style="@style/EncabezadoSeccion"
        android:text="@string/seccion_leyendo"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rejillaLeyendo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="1"
        tools:listitem="@layout/item_leyendo" />

    <TextView
        style="@style/EncabezadoSeccion"
        android:text="@string/seccion_siempre_contigo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/misListasCheckFav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="2"
        tools:listitem="@layout/item_lista_list" />

    <TextView
        style="@style/EncabezadoSeccion"
        android:text="@string/seccion_tuyas" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/misListaPersonalizadas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_lista_list" />

        <!-- Estado vacio: antes solo se veia una zona en blanco sin ninguna explicacion -->
        <LinearLayout
            android:id="@+id/vacioListas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:alpha="0.45"
                android:contentDescription="@null"
                android:src="@drawable/ic_listas"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/tipografia_semibold"
                android:text="@string/vacio_listas_titulo"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vacio_listas_detalle"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_newLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/margen_contenido"
        android:layout_marginBottom="16dp"
        android:minWidth="@dimen/ancho_max_boton"
        android:fontFamily="@font/tipografia_semibold"
        android:paddingVertical="12dp"
        android:text="@string/nueva_lista"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart" />

</LinearLayout>
