<?xml version="1.0" encoding="utf-8"?>
<!-- Resultados de búsqueda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".ResultadoSearchView">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarResultados"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hero_fondo"
        app:title="@string/title_resultados"
        app:titleTextColor="@color/hero_texto" />

    <!-- Acotar la busqueda. Quien no toque nada busca en todo, como siempre. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoAmbito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margen_contenido"
        android:paddingTop="10dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/ambitoTodo"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/ambito_todo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/ambitoTitulo"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ambito_titulo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/ambitoAutor"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ambito_autor" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listRecyclerResultadosLibros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_book_list" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/cargandoResultados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <include
            android:id="@+id/estadoVacio"
            layout="@layout/estado_vacio" />
    </FrameLayout>
</LinearLayout>
