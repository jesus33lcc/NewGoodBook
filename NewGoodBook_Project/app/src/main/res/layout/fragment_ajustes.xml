<?xml version="1.0" encoding="utf-8"?>
<!--
  Ajustes. Sustituye a la pestania que solo servia para cerrar sesion, donde bastaba
  con rozarla para salir de la cuenta. Ahora cerrar sesion es una accion mas dentro de
  la seccion de cuenta, y comparte pantalla con el tema, el idioma y los creditos.
  Mismos encabezados de seccion que Listas, para que las dos se lean igual.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".Fragments.Ajustes">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAjustes"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hero_fondo"
        app:title="@string/title_ajustes"
        app:titleTextColor="@color/hero_texto" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===== Cuenta ===== -->
            <TextView
                style="@style/EncabezadoSeccion"
                android:text="@string/seccion_cuenta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/nombreCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tipografia_semibold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    tools:text="Jesús" />

                <TextView
                    android:id="@+id/correoCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="jesus33lc@gmail.com" />
            </LinearLayout>

            <include
                android:id="@+id/filaGustos"
                layout="@layout/fila_ajuste" />

            <!-- ===== Apariencia ===== -->
            <TextView
                style="@style/EncabezadoSeccion"
                android:text="@string/seccion_apariencia" />

            <include
                android:id="@+id/filaTema"
                layout="@layout/fila_ajuste" />

            <include
                android:id="@+id/filaIdioma"
                layout="@layout/fila_ajuste" />

            <!-- ===== Mi año ===== -->
            <!-- Bloque entero oculto hasta que haya libros suficientes: unas
                 estadisticas a cero se leen como una promesa incumplida. -->
            <TextView
                android:id="@+id/etiquetaMiAnio"
                style="@style/EncabezadoSeccion"
                android:text="@string/seccion_mi_anio"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/bloqueMiAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cifraLibros"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/tipografia_semibold"
                            android:textColor="@color/md_tertiary"
                            android:textSize="30sp"
                            tools:text="12" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mi_anio_libros"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cifraPaginas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/tipografia_semibold"
                            android:textColor="@color/md_tertiary"
                            android:textSize="30sp"
                            tools:text="3.847" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mi_anio_paginas"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.12"
                    android:text="@string/mi_anio_generos"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/listaGeneros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== Acerca de ===== -->
            <TextView
                style="@style/EncabezadoSeccion"
                android:text="@string/seccion_acerca" />

            <include
                android:id="@+id/filaVersion"
                layout="@layout/fila_ajuste" />

            <include
                android:id="@+id/filaCreditos"
                layout="@layout/fila_ajuste" />

            <include
                android:id="@+id/filaLicencia"
                layout="@layout/fila_ajuste" />

            <include
                android:id="@+id/filaDatos"
                layout="@layout/fila_ajuste" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrarCuenta"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/ajuste_borrar_cuenta"
                android:textColor="?attr/colorError"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Borrar la cuenta va dentro del scroll y al final de "Acerca de": es una accion
         destructiva y no debe competir en visibilidad con cerrar sesion. -->

    <!-- Anclado abajo y fuera del scroll, con el mismo formato que el boton de
         crear lista: es la unica accion de la pantalla y cierra el recorrido. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarSesion"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/margen_contenido"
        android:layout_marginBottom="16dp"
        android:minWidth="@dimen/ancho_max_boton"
        android:paddingVertical="12dp"
        android:text="@string/title_cerrar_sesion"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        app:icon="@drawable/baseline_logout_24"
        app:iconGravity="textStart" />

</LinearLayout>
