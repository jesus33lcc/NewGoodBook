<?xml version="1.0" encoding="utf-8"?>
<!-- Autor seleccionable. Usa de fondo la portada de uno de sus libros, oscurecida, en
     vez de un retrato: Google Books no da retratos y unas iniciales sueltas quedan
     pobres al lado de la rejilla de portadas del paso siguiente. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaAutor"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/fondoAutor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- velo fijo para que el nombre se lea sobre cualquier portada -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B00C1E3D" />

        <View
            android:id="@+id/veloAutor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66E89D10"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nombreAutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:fontFamily="@font/chamberi_text_semibold"
            android:maxLines="2"
            android:padding="9dp"
            android:textColor="@color/hero_texto"
            android:textSize="12sp"
            tools:text="Gabriel García Márquez" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
