<?xml version="1.0" encoding="utf-8"?>
<!--
  Ficha de un libro. Mismo tratamiento que la pantalla principal.
  A diferencia de esta, no hay nada anclado abajo, de modo que la pagina entera
  se desplaza como una unidad y la sinopsis no queda encerrada en un recuadro
  con el resto de la pantalla en blanco.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".LibroData">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLibro"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/hero_fondo"
        app:navigationIcon="@drawable/ic_volver"
        app:navigationIconTint="@color/hero_texto"
        app:title="@string/title_activity_libro"
        app:titleTextColor="@color/hero_texto" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Portada y datos, sobre fondo marino. -->
            <LinearLayout
                android:id="@+id/bloquePortada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/hero_fondo"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingTop="4dp"
                android:paddingBottom="26dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="112dp"
                    android:layout_height="168dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="10dp">

                    <ImageView
                        android:id="@+id/imageVPortada"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/desc_portada"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/chamberi_text_semibold"
                        android:maxLines="3"
                        android:textColor="@color/hero_texto"
                        android:textSize="19sp"
                        tools:text="Les Dones i Els Dies" />

                    <TextView
                        android:id="@+id/textAutor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/md_tertiary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Gabriel Ferrater" />

                    <!-- Los datos sueltos van como pildoras: antes eran filas de
                         "etiqueta: valor" que competian en peso con el titulo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textNumPag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/fondo_meta"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/hero_meta"
                            android:textSize="12sp"
                            tools:text="106 págs." />

                        <TextView
                            android:id="@+id/textFechaPub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/fondo_meta"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/hero_meta"
                            android:textSize="12sp"
                            tools:text="2004" />
                        <TextView
                            android:id="@+id/textValoracion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/fondo_meta"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/hero_meta"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_estrella"
                            tools:text="4,2"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textGeneros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/fondo_meta"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/hero_meta"
                        android:textSize="12sp"
                        tools:text="Poesía" />
                </LinearLayout>
            </LinearLayout>

            <!-- Acciones sobre el libro. -->
            <LinearLayout
                android:id="@+id/filaAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margen_contenido">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tBtnFavorite"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorSurface"
                    android:text="@string/accion_favorito"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_favorite_off"
                    app:iconGravity="top"
                    app:iconPadding="2dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tBtnCheck"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorSurface"
                    android:text="@string/accion_leido"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_checkbox_off"
                    app:iconGravity="top"
                    app:iconPadding="2dp"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tBtnAddList"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorSurface"
                    android:text="@string/accion_a_lista"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_addlist"
                    app:iconGravity="top"
                    app:iconPadding="2dp"
                    app:iconSize="20dp" />
            </LinearLayout>


            <!-- Estado de lectura. Antes solo habia "leido", un interruptor: o no
                 habias empezado o habias terminado, y en medio, que es donde uno pasa
                 casi todo el tiempo, la aplicacion no tenia nada que decir. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoEstadoLectura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingTop="14dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/estadoQuiero"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/estado_quiero" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/estadoLeyendo"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/estado_leyendo" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/bloqueProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textoProgreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="Página 182 de 448 · 41 %" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barraProgreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:indicatorColor="@color/md_tertiary"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarPagina"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/actualizar_pagina"
                    android:textSize="13sp" />
            </LinearLayout>
            <!-- Sinopsis. -->
            <TextView
                android:id="@+id/etiquetaSinopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.12"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:text="@string/etiqueta_sinopsis"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chamberi_text_regular"
                android:lineSpacingMultiplier="1.25"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingTop="6dp"
                android:paddingBottom="18dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                tools:text="Publicat el 1968, «Les dones i els dies» recull tota la poesia que Gabriel Ferrater va voler conservar." />

            <!-- Temas y editorial: datos de Open Library. Se ocultan enteros si el
                 libro no los trae, que pasa a menudo. -->
            <TextView
                android:id="@+id/etiquetaTemas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.12"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:text="@string/etiqueta_temas"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoTemas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingTop="6dp"
                app:chipSpacingVertical="0dp" />

            <TextView
                android:id="@+id/textEditorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="@dimen/margen_contenido"
                android:paddingBottom="24dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Editorial · Salamandra" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
